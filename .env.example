# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public base URL used to build application links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# -----------------------------------------------------------------------------
# Optional canonical URL for NextAuth callbacks during local development.
NEXTAUTH_URL=http://localhost:3000
# Secret used by NextAuth to protect authentication sessions.
NEXTAUTH_SECRET=replace-with-nextauth-secret

# GitHub OAuth application ID for signing in with GitHub.
GITHUB_CLIENT_ID=replace-with-github-client-id
# GitHub OAuth application secret for signing in with GitHub.
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
# GitHub API token used to fetch repository information on the home page.
GITHUB_ACCESS_TOKEN=replace-with-github-access-token

# -----------------------------------------------------------------------------
# Database (MySQL - PlanetScale)
# -----------------------------------------------------------------------------
# MySQL connection URL used by Prisma to access application data.
DATABASE_URL="mysql://username:password@localhost:3306/taxonomy"

# -----------------------------------------------------------------------------
# Email (Postmark)
# -----------------------------------------------------------------------------
# Sender address for authentication emails sent through Postmark.
SMTP_FROM=sender@example.com
# Postmark server API token used to send authentication emails.
POSTMARK_API_TOKEN=replace-with-postmark-api-token
# Postmark template ID for returning users' sign-in emails.
POSTMARK_SIGN_IN_TEMPLATE=replace-with-sign-in-template-id
# Postmark template ID for new users' activation emails.
POSTMARK_ACTIVATION_TEMPLATE=replace-with-activation-template-id

# -----------------------------------------------------------------------------
# Subscriptions (Stripe)
# -----------------------------------------------------------------------------
# Stripe secret API key used to manage billing and subscriptions.
STRIPE_API_KEY=replace-with-stripe-api-key
# Stripe webhook signing secret used to verify incoming billing events.
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
# Stripe price ID for the Pro monthly subscription.
STRIPE_PRO_MONTHLY_PLAN_ID=replace-with-stripe-monthly-price-id
